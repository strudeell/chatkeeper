# Ключи и доступы - в репозиторий не попадают никогда.
# Настоящие настройки живут в папке данных плагина, не здесь.
# Образец .env.example остаётся: в нём только имена переменных, без значений.
.env
*.env
.env.*
!.env.example
*.session
*.session-journal
*.key
*.pem

# Окружение python создаётся при установке, в поставку не входит
.venv/
__pycache__/
*.pyc

# Рабочие данные и всё, что связано с перепиской
state/
*.ics
tmp/
*.ogg
inbox.md
commitments.json
runtime.json
bot_state.json
