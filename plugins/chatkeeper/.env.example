# Chatkeeper - образец файла с ключами.
# Настоящие значения лежат рядом, в файле .env, и в git не попадают никогда.

# Токен бота. Выдаёт @BotFather. Бот делает две вещи сразу:
# приносит сообщения из личных чатов и присылает утреннюю сводку.
TELEGRAM_BOT_TOKEN=

# Твой числовой id в телеграме - кому бот шлёт сводку.
# Заполняется автоматически при установке.
TELEGRAM_OWNER_ID=

# Откуда берутся сообщения:
#   bot     - бот, подключённый в настройках телеграма («Telegram для бизнеса» ->
#             «Чат-боты»). Личные чаты, только новые сообщения. Ничего не требует.
#             Обычный выбор, оставь как есть.
#   account - вход под живым аккаунтом. Видит группы и историю, но требует ключи
#             ниже, а получить их удаётся не всем.
CHATKEEPER_SOURCE=bot

# Нужны ТОЛЬКО при CHATKEEPER_SOURCE=account. При работе через бота оставь пустыми.
# Берутся на https://my.telegram.org -> API development tools.
# Это ключ от твоего аккаунта: никому не показывать, в чат не вставлять.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
